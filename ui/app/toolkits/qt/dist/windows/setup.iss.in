; Builds with the auto-updater ("ON") offer to switch it on; others don't.
#define AutoUpdate "@HAVE_UNFOLD_AUTO_UPDATE@"

[Setup]
; stopme Qt is its own product: it installs side by side with stopme (the
; Gtk build) and with Workrave, and neither setup touches the others.
AppId=stopmeQt
AppName=stopme Qt
AppVersion=@WORKRAVE_VERSION@
AppVerName=stopme Qt @WORKRAVE_VERSION@
AppPublisher=stopme contributors
AppPublisherURL=https://github.com/AcodeFaylo/stopme
AppSupportURL=https://github.com/AcodeFaylo/stopme
AppUpdatesURL=https://github.com/AcodeFaylo/stopme
DefaultDirName={autopf}\stopme Qt
DefaultGroupName=stopme Qt
LicenseFile=@INSTALL_WIN_PATH@\COPYING.txt
AppMutex=WorkraveQtMutex
SetupIconFile=@INSTALL_WIN_PATH@\dist\stopme.ico
UninstallDisplayIcon={app}\bin\stopmeQt.exe
WizardImageFile=@INSTALL_WIN_PATH@\dist\WizModernImage.bmp,@INSTALL_WIN_PATH@\dist\WizModernImage-328x604.bmp
WizardSmallImageFile=@INSTALL_WIN_PATH@\dist\WizModernSmall.bmp,@INSTALL_WIN_PATH@\dist\WizModernSmall-110x106.bmp
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
CloseApplications=yes
RestartApplications=no
ArchitecturesInstallIn64BitMode=x64compatible
#ifdef SignTool
SignTool={#SignTool}
SignedUninstaller=yes
#endif

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop icon"; GroupDescription: "Additional tasks:"
Name: "startupmenu"; Description: "Start stopme Qt when Windows starts"; GroupDescription: "Additional tasks:"
#if AutoUpdate == "ON"
Name: "autoupdate"; Description: "Automatically check for updates"; GroupDescription: "Additional tasks:"
#endif

[Files]
;TODO;Source: "@INSTALL_WIN_PATH@\bin\harpoon64.dll"; DestDir: "{app}\bin"; Flags: ignoreversion recursesubdirs restartreplace uninsrestartdelete;
Source: "@INSTALL_WIN_PATH@\bin\workrave.exe"; DestDir: "{app}\bin"; DestName: "stopmeQt.exe"; Flags: ignoreversion;
Source: "@INSTALL_WIN_PATH@\bin\qt.conf"; DestDir: "{app}\bin"; Flags: ignoreversion;
Source: "@INSTALL_WIN_PATH@\lib\plugins\*.*"; DestDir: "{app}\lib\plugins"; Flags: ignoreversion recursesubdirs restartreplace uninsrestartdelete;
Source: "@INSTALL_WIN_PATH@\share\*.*"; DestDir: "{app}\share"; Flags: ignoreversion recursesubdirs;
Source: "@INSTALL_WIN_PATH@\COPYING.txt"; DestDir: "{app}"; DestName: "COPYING.txt"; Flags: ignoreversion;
Source: "@INSTALL_WIN_PATH@\AUTHORS.txt"; DestDir: "{app}"; DestName: "AUTHORS.txt"; Flags: ignoreversion;
Source: "@INSTALL_WIN_PATH@\NEWS.txt"; DestDir: "{app}"; DestName: "NEWS.txt"; Flags: ignoreversion;
Source: "@INSTALL_WIN_PATH@\README.txt"; DestDir: "{app}"; DestName: "README.txt"; Flags: ignoreversion;

#include "libraries.iss"

[Registry]
Root: HKCU; Subkey: "SOFTWARE\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "stopme Qt"; ValueData: "{app}\bin\stopmeQt.exe"; Flags: uninsdeletevalue; Tasks: startupmenu

[Icons]
Name: "{group}\stopme Qt"; Filename: "{app}\bin\stopmeQt.exe"
Name: "{group}\News"; Filename: "{app}\NEWS.txt"
Name: "{group}\Read me"; Filename: "{app}\README.txt"
Name: "{group}\License"; Filename: "{app}\COPYING.txt"
Name: "{group}\Uninstall"; Filename: "{uninstallexe}"
Name: "{autodesktop}\stopme Qt"; Filename: "{app}\bin\stopmeQt.exe"; MinVersion: 4,4; Tasks: desktopicon
Name: "{app}\stopme Qt"; Filename: "{app}\bin\stopmeQt.exe"

[Run]
Filename: "{app}\bin\stopmeQt.exe"; Description: "Launch stopme Qt"; Flags: nowait postinstall shellexec;

[InstallDelete]
Type: files; Name: "{app}\share\sounds\*.wav"

[Code]
Var
  taskPageShown: boolean;

function GetInstallLocation(): String; forward;

procedure InitializeWizard();
begin
  // Do not require accepting the GPL license on Windows installation
  WizardForm.LicenseAcceptedRadio.Checked := True;
  WizardForm.LicenseAcceptedRadio.Visible := False;
  WizardForm.LicenseNotAcceptedRadio.Visible := False;
  WizardForm.LicenseLabel1.Visible := False;
  WizardForm.LicenseMemo.Top := WizardForm.LicenseLabel1.Top;
  WizardForm.LicenseMemo.Height :=
    WizardForm.LicenseNotAcceptedRadio.Top +
    WizardForm.LicenseNotAcceptedRadio.Height -
    WizardForm.LicenseMemo.Top - ScaleY(5);
end;

Function InitializeSetup() : Boolean;
begin
    taskPageShown := False;
    Result := True;
end;

function GetAppPath(S: String): String;
begin
  Result := WizardDirValue + '\bin';
end;

function IsX64: Boolean;
begin
  Result := (ProcessorArchitecture = paX64);
end;

#if AutoUpdate == "ON"
Procedure UpdateAutoInstallTask();
var
  success: boolean;
  enabledStr: string;
  enabled: boolean;
begin
  enabled := False;

  success := RegQueryStringValue(HKCU, 'Software\Workrave\plugins\auto_update', 'enabled', enabledStr);
  if success and (enabledStr = '1') then
  begin
    enabled := True;
  end;

  if enabled then
  begin
    WizardSelectTasks('autoupdate');
  end
  else
  begin
    WizardSelectTasks('!autoupdate');
  end
end;

Procedure UpdateAutoInstallSetting();
var
  enabledStr: string;
begin
  if WizardIsTaskSelected('autoupdate') then
    enabledStr := '1'
  else
    enabledStr := '0';
  RegWriteStringValue(HKCU, 'Software\Workrave\plugins\auto_update', 'enabled', enabledStr);
#ifdef Channel
  RegWriteStringValue(HKCU, 'Software\Workrave\plugins\auto_update', 'channel', '{#Channel}');
#endif
end;
#endif

function GetInstallLocation(): String;
var
  uninstallPath: String;
  installLocation: String;
begin
  uninstallPath := ExpandConstant('Software\Microsoft\Windows\CurrentVersion\Uninstall\stopmeQt_is1');
  installLocation := '';

  if not RegQueryStringValue(HKLM, uninstallPath, 'InstallLocation', installLocation) then
    if not RegQueryStringValue(HKLM32, uninstallPath, 'InstallLocation', installLocation) then
      if not RegQueryStringValue(HKCU, uninstallPath, 'InstallLocation', installLocation) then
        RegQueryStringValue(HKCU32, uninstallPath, 'InstallLocation', installLocation);
  Result := installLocation;
end;

#if AutoUpdate == "ON"
Procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = wpSelectTasks) and not taskPageShown then
  begin
    taskPageShown := True;
    UpdateAutoInstallTask();
  end
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssDone then
  begin
    UpdateAutoInstallSetting();
  end;
end;
#endif
